            "state": "translated",
            "value": "Anmelden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión"
          }
        },
        "zh-Hant-HK": {
