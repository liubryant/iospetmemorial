    "今天，想去哪里坐坐？": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天，想去哪里坐坐？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where would you like to spend a moment?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでひとときを過ごしたいですか？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo möchten Sie einen Moment verbringen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où aimeriez-vous passer un moment ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde te gustaría pasar un momento?"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "今天，想去哪裡坐坐？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디에서 잠시 시간을 보내고 싶으신가요?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين تريد أن تقضي لحظة؟"
          }
        }
      }
    },
    "轻点目的地即可抵达。建筑门前也可以进入。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点目的地即可抵达。建筑门前也可以进入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a destination to visit. You can also enter at the building’s door."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問する目的地をタップします。建物入口からもお入りいただけます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf ein Ziel, das Sie besuchen möchten. Sie können das Gebäude auch durch die Tür betreten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur une destination à visiter. Vous pouvez également entrer par la porte du bâtiment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un destino para visitar. También puedes entrar por la puerta del edificio."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點目的地即可抵達。建築門前也可以進入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문할 목적지를 탭하세요. 건물 문으로 들어가셔도 됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على وجهة للزيارة. يمكنك أيضًا الدخول من باب المبنى."
          }
        }
      }
    },
