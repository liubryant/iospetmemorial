    "暂时无法读取登录信息，请解锁设备后重试": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法读取登录信息，请解锁设备后重试"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The login information cannot be read temporarily. Please unlock the device and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン情報が一時的に読み取れなくなりました。デバイスのロックを解除して、もう一度試してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldeinformationen können vorübergehend nicht gelesen werden. Bitte entsperren Sie das Gerät und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations de connexion ne peuvent pas être lues temporairement. Veuillez déverrouiller l'appareil et réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información de inicio de sesión no se puede leer temporalmente. Desbloquee el dispositivo e inténtelo de nuevo."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法讀取登入訊息，請解鎖裝置後重試"
          }
        },
        "ko": {
