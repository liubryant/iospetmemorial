    "在纪念碑详情中轻触爱心，\n下次就能很快找到它。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在纪念碑详情中轻触爱心，\n下次就能很快找到它。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the heart in the monument details,\nYou'll find it quickly next time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記念碑の詳細にあるハートをタップすると、\n次回からはすぐに見つかります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie in den Denkmaldetails auf das Herz.\nBeim nächsten Mal werden Sie es schnell finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le cœur dans les détails du monument,\nVous le trouverez rapidement la prochaine fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el corazón en los detalles del monumento,\nLo encontrarás rápidamente la próxima vez."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在紀念碑詳情中輕觸愛心，\n下次就能很快找到它。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기념물 세부정보에서 하트를 탭하고,\n다음번에는 빨리 찾으실 수 있을 거예요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على القلب في تفاصيل النصب،\nستجده بسرعة في المرة القادمة."
          }
        }
      }
    },
    "试试其他名字或碑号，也可以先认领一座纪念碑。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试其他名字或碑号，也可以先认领一座纪念碑。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another name or plot number, or claim a memorial plot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の名前または区画番号を試すか、記念区画を申請してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es mit einem anderen Namen oder einer anderen Grundstücksnummer oder beanspruchen Sie ein Gedenkgrundstück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez un autre nom ou un autre numéro de parcelle, ou réclamez une parcelle commémorative."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruebe con otro nombre o número de parcela, o reclame una parcela conmemorativa."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "試試其他名字或碑號，也可以先認領一座紀念碑。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 이름이나 구획 번호를 시도하거나 기념 구획을 신청하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرب اسمًا آخر أو رقم قطعة أرض، أو قم بالمطالبة بقطعة أرض تذكارية."
          }
        }
      }
    },
    "%02d 号纪念碑": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%02d 号纪念碑"
          }
        },
