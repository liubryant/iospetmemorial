    "去追小球吧，我们在这里等你。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去追小球吧，我们在这里等你。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go fetch! We will wait for you here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取りに行って！ここでお待ちしております。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh holen! Wir werden hier auf Sie warten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez chercher ! Nous vous attendrons ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Ve a buscar! Te esperaremos aquí."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "去追小球吧，我們在這裡等你。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가서 가져오세요! 우리는 여기서 당신을 기다릴 것입니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اذهب واحضر! سوف ننتظرك هنا."
          }
        }
      }
    },
    "它把小球带回来了，再陪它玩一次吧。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它把小球带回来了，再陪它玩一次吧。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your companion brought the ball back. Play again?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの仲間がボールを持ち帰ってきました。また遊びますか？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Begleiter hat den Ball zurückgebracht. Noch einmal spielen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compagnon a ramené le ballon. Rejouer ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compañero devolvió el balón. ¿Jugar de nuevo?"
          }
