            "value": "ليس الآن"
          }
        }
      }
    },
    "同意并备份": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意并备份"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agree and back up"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同意してバックアップする"
          }
        },
        "de": {
