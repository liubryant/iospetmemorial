            "value": "ولكل ذكرى وطن"
          }
        }
      }
    },
    "寻找一位伙伴，或回到你最牵挂的地方。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "寻找一位伙伴，或回到你最牵挂的地方。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a companion or return to a place close to your heart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仲間を見つけるか、心に近い場所に戻るか。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finden Sie einen Begleiter oder kehren Sie an einen Ort zurück, der Ihnen am Herzen liegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez un compagnon ou retournez dans un endroit qui vous tient à cœur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra un compañero o regresa a un lugar cercano a tu corazón."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找一位夥伴，或回到你最牽掛的地方。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동반자를 찾거나 마음과 가까운 곳으로 돌아가세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن رفيق أو عد إلى مكان قريب من قلبك."
          }
        }
      }
    },
