    "用云备份替换本机资料？": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用云备份替换本机资料？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace local data with cloud backup?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル データをクラウド バックアップに置き換えますか?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Daten durch Cloud-Backup ersetzen?"
          }
        },
        "fr": {
