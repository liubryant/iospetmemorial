    "把它的小习惯、喜欢的食物，或最难忘的瞬间写下来。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把它的小习惯、喜欢的食物，或最难忘的瞬间写下来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write down his little habits, favorite foods, or most memorable moments."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彼の小さな習慣、好きな食べ物、または最も思い出に残る瞬間を書き留めてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie seine kleinen Gewohnheiten, Lieblingsspeisen oder denkwürdigsten Momente auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez ses petites habitudes, ses plats préférés ou ses moments les plus mémorables."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota sus pequeños hábitos, sus comidas favoritas o sus momentos más memorables."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "把它的小習慣、喜歡的食物，或是最難忘的瞬間寫下來。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그의 작은 습관, 좋아하는 음식, 가장 기억에 남는 순간을 적어보세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب عاداته الصغيرة أو الأطعمة المفضلة أو اللحظات التي لا تنسى."
