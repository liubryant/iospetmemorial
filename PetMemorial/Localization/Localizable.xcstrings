    "添加生日或告别日期，\n让特别的日子被温柔记住。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加生日或告别日期，\n让特别的日子被温柔记住。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a birthday or farewell date\nto remember those special days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誕生日または別れの日を追加する\n特別な日を思い出すために。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie ein Geburtstags- oder Abschiedsdatum hinzu\num mich an diese besonderen Tage zu erinnern."
          }
        },
        "fr": {
