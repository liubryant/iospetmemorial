            "state": "translated",
            "value": "Jede Erinnerung hat ein Zuhause"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque souvenir a une maison"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
