{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "先为它留一个位置": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先为它留一个位置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a place for your companion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仲間のための場所を作る"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen Sie einen Platz für Ihren Begleiter"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une place à votre compagnon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazle un lugar a tu acompañante"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "先為它留一個位置"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동반자를 위한 자리를 만들어주세요"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خصص مكانًا لرفيقك"
          }
        }
      }
    },
    "在花园页创建纪念资料，\n就能珍藏你们的照片。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在花园页创建纪念资料，\n就能珍藏你们的照片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a memorial profile in the Garden to start saving your photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の保存を開始するには、Garden で記念プロフィールを作成します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie im Garten ein Gedenkprofil, um mit dem Speichern Ihrer Fotos zu beginnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un profil commémoratif dans le jardin pour commencer à enregistrer vos photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un perfil conmemorativo en el Jardín para comenzar a guardar tus fotos."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在花園頁創建紀念資料，\n就能珍藏你們的照片。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 저장하려면 정원에 기념 프로필을 만드세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإنشاء ملف تعريف تذكاري في الحديقة لبدء حفظ صورك."
          }
        }
      }
    },
    "把最喜欢的瞬间留下": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把最喜欢的瞬间留下"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your favorite moments"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りの瞬間を残しましょう"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihre Lieblingsmomente fest"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos moments préférés"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus momentos favoritos"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "把最喜歡的瞬間留下"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아하는 순간을 간직하세요"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بلحظاتك المفضلة"
          }
        }
      }
    },
    "点击右上角添加照片。\n第一张照片也会出现在 3D 花园中。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击右上角添加照片。\n第一张照片也会出现在 3D 花园中。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the button at the top to add a photo.\nYour first photo will also appear in the 3D garden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部のボタンをタップして写真を追加します。\n最初の写真も 3D ガーデンに表示されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie oben auf die Schaltfläche, um ein Foto hinzuzufügen.\nIhr erstes Foto erscheint auch im 3D-Garten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le bouton en haut pour ajouter une photo.\nVotre première photo apparaîtra également dans le jardin 3D."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el botón en la parte superior para agregar una foto.\nTu primera foto también aparecerá en el jardín 3D."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊右上角新增照片。\n第一張照片也會出現在 3D 花園。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 추가하려면 상단의 버튼을 탭하세요.\n첫 번째 사진도 3D 정원에 나타납니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الزر في الأعلى لإضافة صورة.\nستظهر صورتك الأولى أيضًا في الحديقة ثلاثية الأبعاد."
          }
        }
      }
    },
