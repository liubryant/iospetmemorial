    "风会记得，你来过这里。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风会记得，你来过这里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wind will remember that you have been here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "風はあなたがここにいたことを覚えているでしょう。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wind wird sich daran erinnern, dass Sie hier waren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vent se souviendra que vous étiez ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El viento recordará que has estado aquí."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "風會記得，你來過這裡。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바람은 당신이 여기에 있었다는 것을 기억할 것입니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف تتذكر الريح أنك كنت هنا."
          }
        }
      }
    },
