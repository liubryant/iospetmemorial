    "照片无法读取或超过 30 MB，请换一张。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片无法读取或超过 30 MB，请换一张。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo cannot be read or exceeds 30 MB. Please try another one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真が読み取れないか、30 MB を超えています。別のものをお試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto kann nicht gelesen werden oder überschreitet 30 MB. Bitte versuchen Sie es mit einem anderen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo n'est pas lisible ou dépasse 30 Mo. Veuillez en essayer un autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto no se puede leer o supera los 30 MB. Por favor prueba con otro."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "照片無法讀取或超過 30 MB，請換一張。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 읽을 수 없거나 30MB를 초과합니다. 다른 것을 시도해 보세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن قراءة الصورة أو يتجاوز حجمها 30 ميغابايت. يرجى تجربة واحدة أخرى."
          }
        }
      }
    },
    "写一句照片背后的故事": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写一句照片背后的故事"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The story behind this photo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真の裏話"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geschichte hinter diesem Foto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'histoire derrière cette photo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La historia detrás de esta foto"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫一句照片背後的故事"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진 뒤에 숨겨진 이야기"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القصة وراء هذه الصورة"
          }
        }
      }
    },
    "最多 6 张。照片会压缩为适合手机显示的副本，原照片不受影响。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 6 张。照片会压缩为适合手机显示的副本，原照片不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save up to 6 photos. We keep a smaller copy for your phone; your originals stay unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大6枚の写真を保存できます。携帯電話用に小さいコピーを保管しておきます。オリジナルは変更されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie bis zu 6 Fotos. Wir bewahren eine kleinere Kopie für Ihr Telefon auf; Ihre Originale bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez jusqu'à 6 photos. Nous conservons une copie plus petite pour votre téléphone ; vos originaux restent inchangés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda hasta 6 fotos. Guardamos una copia más pequeña para su teléfono; sus originales permanecen sin cambios."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 6 張。照片會壓縮為適合手機顯示的副本，原始照片不受影響。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 6장의 사진을 저장하세요. 우리는 귀하의 휴대폰에 더 작은 사본을 보관합니다. 원본은 변경되지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفظ ما يصل إلى 6 صور. نحتفظ بنسخة أصغر لهاتفك؛ تبقى أصولك الأصلية دون تغيير."
          }
        }
      }
    },
