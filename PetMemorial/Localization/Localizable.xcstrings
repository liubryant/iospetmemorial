    "外观仅保存在本机，也可在小镇顶部菜单切换。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观仅保存在本机，也可在小镇顶部菜单切换。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The appearance is only saved locally and can also be switched in the top menu of the town."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目はローカルにのみ保存され、街のトップメニューからも切り替えることができます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erscheinungsbild wird nur lokal gespeichert und kann auch im oberen Menü der Stadt umgeschaltet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apparence n'est enregistrée que localement et peut également être modifiée dans le menu supérieur de la ville."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La apariencia sólo se guarda localmente y también se puede cambiar en el menú superior de la ciudad."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "外觀僅儲存在本機，也可在小鎮頂部選單切換。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외형은 로컬에만 저장되며, 마을 상단 메뉴에서도 변경할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم حفظ المظهر محليًا فقط ويمكن أيضًا تبديله في القائمة العلوية للمدينة."
          }
        }
      }
    },
