    "爱不会因为告别而消失。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "爱不会因为告别而消失。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Love doesn't disappear just because we say goodbye."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別れを告げたからといって愛は消えるわけではありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liebe verschwindet nicht, nur weil wir uns verabschieden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'amour ne disparaît pas simplement parce que nous disons au revoir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El amor no desaparece sólo porque decimos adiós."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "愛不會因為告別而消失。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이별만 한다고 사랑이 사라지는 것은 아니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحب لا يختفي بمجرد أن نقول وداعا."
          }
        }
      }
    },
