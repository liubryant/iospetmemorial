            "value": "Bei Bedarf wird nach der Bestätigung per SMS automatisch ein neues Konto erstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau compte est créé automatiquement après vérification par SMS si nécessaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crea una nueva cuenta automáticamente después de la verificación por SMS si es necesario."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證碼驗證成功後，未註冊帳號將自動註冊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 경우 SMS 확인 후 새 계정이 자동으로 생성됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إنشاء حساب جديد تلقائيًا بعد التحقق عبر الرسائل القصيرة إذا لزم الأمر."
          }
        }
      }
    },
