    "单指拖动旋转，双指缩放，轻触宠物互动": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单指拖动旋转，双指缩放，轻触宠物互动"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use one finger to drag to rotate, two fingers to zoom, and tap to interact with pets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 本の指でドラッグして回転し、2 本の指でズームし、タップしてペットと対話します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie einen Finger zum Ziehen zum Drehen, zwei Finger zum Zoomen und Tippen, um mit Haustieren zu interagieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un doigt pour faire glisser pour faire pivoter, deux doigts pour zoomer et appuyez pour interagir avec les animaux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice un dedo para arrastrar y rotar, dos dedos para hacer zoom y toque para interactuar con las mascotas."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "單指拖曳旋轉，雙指縮放，輕觸寵物互動"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 손가락으로 드래그하여 회전하고, 두 손가락으로 확대/축소하고, 탭하여 애완동물과 상호작용하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم إصبعًا واحدًا للسحب للتدوير، وإصبعين للتكبير/التصغير، وانقر للتفاعل مع الحيوانات الأليفة."
