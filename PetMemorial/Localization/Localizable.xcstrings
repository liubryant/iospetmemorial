    "浅色为空位，爱心表示已有伙伴。轻触即可前往。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浅色为空位，爱心表示已有伙伴。轻触即可前往。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light plots are available. Hearts mark claimed memorials. Tap to visit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るい色は空きスペース、ハートは使用中の印です。タップして訪れましょう。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helle Plätze sind frei, Herzen markieren belegte Plätze. Zum Besuchen antippen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les emplacements clairs sont libres, les cœurs indiquent les emplacements occupés. Touchez pour visiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los espacios claros están disponibles y los corazones indican espacios ocupados. Toca para visitar."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "淺色為空位，愛心表示已有夥伴。輕觸即可前往。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝은색은 빈 공간, 하트는 이미 반려동물이 있는 공간입니다. 눌러서 방문하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأماكن الفاتحة متاحة، والقلوب تشير إلى مواقع محجوزة. اضغط للزيارة."
          }
        }
      }
    },
