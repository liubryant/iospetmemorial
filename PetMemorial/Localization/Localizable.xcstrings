          "stringUnit": {
            "state": "translated",
            "value": "Keep photos, stories and words left unsaid\nin a garden that belongs to you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真、ストーリー、言葉を言わずに残しておきます\nあなただけの庭で。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Fotos, Geschichten und Worte unausgesprochen\nin einem Garten, der dir gehört."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez les photos, les histoires et les mots non-dits\ndans un jardin qui vous appartient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga las fotos, historias y palabras sin decir\nen un jardín que te pertenece."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "把照片、故事和沒說完的話，\n放進只屬於你們的紀念花園。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진, 이야기, 말하지 않은 단어를 남겨두세요\n당신의 정원에서."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بالصور والقصص والكلمات دون أن تقال\nفي الحديقة التي تنتمي إليك."
          }
        }
      }
    },
