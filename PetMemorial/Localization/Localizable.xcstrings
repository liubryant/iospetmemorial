          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 계정 정원이 준비되었습니다. 손님 추억은 별도로 남아 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حديقة حسابك جاهزة. تبقى ذكريات الضيف منفصلة."
          }
