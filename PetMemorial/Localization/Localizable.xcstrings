        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شمعة لتدفئة هذه الذكرى."
          }
        }
      }
    },
    "每一份想念，都有归处": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一份想念，都有归处"
          }
        },
        "en": {
