        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 편지에 말하지 않은 내용을 적어주세요"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب ما لم يُقال في رسالة خاصة"
          }
        }
      }
    },
    "散步、抚摸、追球，陪它待一会儿": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "散步、抚摸、追球，陪它待一会儿"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk, pet, play fetch, or simply stay awhile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "散歩したり、撫でたり、取ってきて遊んだり、ただしばらく滞在したりしてください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie spazieren, streicheln Sie, spielen Sie Apportieren oder bleiben Sie einfach eine Weile"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchez, caressez, jouez à rapporter ou restez simplement un moment"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Camine, acaricie, juegue a buscar objetos o simplemente quédese un rato"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "散步、撫摸、追球，陪它待一會兒"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걷기, 쓰다듬기, 물건 가져오기 놀이 또는 잠시 머물기"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالمشي، أو الحيوانات الأليفة، أو لعب لعبة الجلب، أو ببساطة البقاء لبعض الوقت"
          }
        }
      }
    },
    "本机资料读取失败。为保护原有记录，暂不覆盖，请保留应用并联系支持。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机资料读取失败。为保护原有记录，暂不覆盖，请保留应用并联系支持。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to read local data. To protect the original records, they will not be overwritten for now. Please keep the application and contact support."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルデータの読み取りに失敗しました。元のレコードを保護するため、現時点では上書きされません。アプリケーションを保管し、サポートにお問い合わせください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Daten konnten nicht gelesen werden. Um die Originaldatensätze zu schützen, werden diese vorerst nicht überschrieben. Bitte bewahren Sie die Anwendung auf und wenden Sie sich an den Support."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la lecture des données locales. Afin de protéger les enregistrements originaux, ils ne seront pas écrasés pour le moment. Veuillez conserver l'application et contacter le support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los datos locales. Para proteger los registros originales, no se sobrescribirán por ahora. Conserve la solicitud y comuníquese con el soporte."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本機資料讀取失敗。為保護原有記錄，暫不覆蓋，請保留應用程式並聯絡支援。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 데이터를 읽지 못했습니다. 원본 기록을 보호하기 위해 지금은 덮어쓰지 않습니다. 신청서를 보관하시고 지원팀에 문의하시기 바랍니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل في قراءة البيانات المحلية. ولحماية السجلات الأصلية، لن تتم الكتابة فوقها في الوقت الحالي. يرجى الاحتفاظ بالتطبيق والاتصال بالدعم."
          }
        }
      }
    },
