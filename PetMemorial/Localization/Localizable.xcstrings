          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kerze, um diese Erinnerung zu wärmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bougie pour réchauffer ce souvenir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
