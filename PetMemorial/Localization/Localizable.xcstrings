    },
    "把没说完的话，写进私密信箱": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把没说完的话，写进私密信箱"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write what is left unsaid in a private letter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言い残した内容を個人的な手紙に書く"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie, was unausgesprochen bleibt, in einen privaten Brief"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez ce qui n'est pas dit dans une lettre privée"
