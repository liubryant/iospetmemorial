    "本机保存失败，请检查设备存储空间后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机保存失败，请检查设备存储空间后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device failed to save, please check the device storage space and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの保存に失敗しました。デバイスのストレージ容量を確認して、もう一度試してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät konnte nicht gespeichert werden. Bitte überprüfen Sie den Speicherplatz des Geräts und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil n'a pas pu enregistrer, veuillez vérifier l'espace de stockage de l'appareil et réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo no pudo guardarse. Verifique el espacio de almacenamiento del dispositivo e inténtelo nuevamente."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本機保存失敗，請檢查設備儲存空間後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 저장에 실패했습니다. 기기 저장 공간을 확인한 후 다시 시도해 주세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل حفظ الجهاز، يرجى التحقق من مساحة تخزين الجهاز والمحاولة مرة أخرى."
          }
        }
      }
    },
    "一起让花园更好用": {
