        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 동반자가 공을 다시 가져왔습니다. 다시 플레이하시겠습니까?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد رفيقك الكرة. العب مرة أخرى؟"
          }
