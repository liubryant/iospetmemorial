    "为你的伙伴认领一个位置，每人限一座纪念碑。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你的伙伴认领一个位置，每人限一座纪念碑。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claim a place for your companion. Each person can claim one memorial."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの仲間のために場所を確保してください。各人が 1 つの記念碑を請求できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beanspruchen Sie einen Platz für Ihren Begleiter. Jede Person kann ein Denkmal beanspruchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réclamez une place pour votre compagnon. Chaque personne peut réclamer un mémorial."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclama una plaza para tu acompañante. Cada persona puede reclamar un monumento."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "為你的夥伴認領一個位置，每人限一座紀念碑。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동반자를 위한 자리를 확보하세요. 각 사람은 하나의 기념물을 요청할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المطالبة بمكان لرفيقك. يمكن لكل شخص المطالبة بنصب تذكاري واحد."
          }
        }
      }
    },
