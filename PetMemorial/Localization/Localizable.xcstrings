        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo could not be read. Please choose another."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真は読み取れませんでした。別のものを選択してください。"
