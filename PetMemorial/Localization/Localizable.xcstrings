            "value": "Votre jardin de compte est prêt. Les souvenirs des invités restent séparés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su jardín de cuentas está listo. Los recuerdos de los huéspedes permanecen separados."
