        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشغيل هذا التطبيق بواسطة شركة Shenzhen Chunjiang Yueming Technology Co., Ltd. اتصل بالبريد الإلكتروني: bryant_liu24@126.com. يرجى الاطلاع على قواعد معالجة البيانات الكاملة في \"My → Privacy Policy\"؛ يمكن الاتصال بطلبات إلغاء الحساب وحقوق البيانات من خلال هذا البريد الإلكتروني."
          }
        }
      }
    },
    "一束花，替你说想念。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一束花，替你说想念。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flowers to say you are remembered."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたを覚えていると伝える花。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blumen als Zeichen Ihrer Erinnerung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des fleurs pour dire qu'on se souvient de vous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flores para decir que te recuerdan."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "一束花，替你說想念。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신을 기억한다는 말을 전하는 꽃."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزهور لتقول أنك تذكرت."
          }
        }
      }
    },
    "一盏灯，温暖这份记忆。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一盏灯，温暖这份记忆。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A candle to warm this memory."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
